//-----------------------------------------------------------------------------
// TABELLA
//-----------------------------------------------------------------------------
var tbl = table.new(pos,7,42,frame_color=color.rgb(120,123,134),frame_width=1,border_width=1,border_color=color.rgb(187,189,194))

if barstate.islast
    table.clear(tbl,0,0,6,41)
    table.cell(tbl,0,0,"TF " + screenerTf + " · " + str.tostring(minInteractionBars) + "/" + str.tostring(interactionWindow),bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
    table.cell(tbl,1,0,"PREZZO",bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
    table.cell(tbl,2,0,"BALANCE",bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
    table.cell(tbl,3,0,"TOCCHI",bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
    table.cell(tbl,4,0,"STATO",bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
    table.cell(tbl,5,0,"SCORE",bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
    table.cell(tbl,6,0,"ST/H/T/R",bgcolor=mainBg,text_color=txtColor,text_size=labelSize,height=rowHeight)

    outTicker = array.new_string()
    outPrice = array.new_float()
    outCenter = array.new_float()
    outStrength = array.new_float()
    outRel = array.new_float()
    outHits = array.new_int()
    outTests = array.new_int()
    outTouches = array.new_int()
    outZoneType = array.new_int()
    outEngine = array.new_int()
    outDist = array.new_float()
    outScore = array.new_float()

    for i = 0 to 38
        if array.get(shows,i)
            string sym = array.get(symbols,i)
            [p,center,half,strength,rel,hits,tests,touches,zoneType,engineType,distAtr,score] = request.security(sym,screenerTf,f_balanceActiveEngine(),ignore_invalid_symbol=true,calc_bars_count=lookback + 100)
            bool active = not na(center) and touches >= minInteractionBars and (not requireLastInside or distAtr == 0.0)
            bool include = onlyActive ? active : not na(center)
            if include and not na(p)
                array.push(outTicker,f_ticker(sym))
                array.push(outPrice,p)
                array.push(outCenter,center)
                array.push(outStrength,strength)
                array.push(outRel,rel)
                array.push(outHits,hits)
                array.push(outTests,tests)
                array.push(outTouches,touches)
                array.push(outZoneType,zoneType)
                array.push(outEngine,engineType)
                array.push(outDist,distAtr)
                array.push(outScore,score)

    int n = array.size(outTicker)
    if n == 0
        table.cell(tbl,0,1,"Nessuna Balance selezionata sul TF " + screenerTf,bgcolor=color.new(mainBg,10),text_color=txtColor,text_size=labelSize,height=rowHeight)
    else
        sortIdx = array.sort_indices(outScore,order.descending)
        int rowsToShow = math.min(n,39)
        for r = 0 to rowsToShow - 1
            int j = array.get(sortIdx,r)
            int row = r + 1
            string tk = array.get(outTicker,j)
            float px = array.get(outPrice,j)
            float center = array.get(outCenter,j)
            float strength = array.get(outStrength,j)
            float rel = array.get(outRel,j)
            int hits = array.get(outHits,j)
            int tests = array.get(outTests,j)
            int touches = array.get(outTouches,j)
            int zoneType = array.get(outZoneType,j)
            int engineType = array.get(outEngine,j)
            float distAtr = array.get(outDist,j)
            float score = array.get(outScore,j)

            string stats = str.tostring(int(math.round(strength))) + "/" + str.tostring(hits) + "/" + str.tostring(tests) + "/" + (na(rel) ? "—" : str.tostring(int(math.round(rel))))
            bool insideNow = distAtr == 0.0
            string engineSuffix = engineType == ENGINE_REACTION ? " · RB" : ""
            string state = insideNow ? "● AREA ATTIVA" + engineSuffix : "○ TOCCATA RECENTE" + engineSuffix + " · " + str.tostring(distAtr,"#.00") + " ATR"
            color stateTextColor = engineType == ENGINE_REACTION ? reactionTextColor : insideNow ? insideTextColor : center < px ? supportTextColor : resistanceTextColor
            color rowBg = activeBg

            table.cell(tbl,0,row,tk,text_halign=text.align_left,bgcolor=rowBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
            table.cell(tbl,1,row,str.tostring(px,"#.########"),bgcolor=rowBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
            table.cell(tbl,2,row,str.tostring(center,"#.########"),bgcolor=rowBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
            table.cell(tbl,3,row,str.tostring(touches) + "/" + str.tostring(interactionWindow),bgcolor=rowBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
            table.cell(tbl,4,row,state,bgcolor=rowBg,text_color=stateTextColor,text_size=labelSize,height=rowHeight)
            table.cell(tbl,5,row,str.tostring(score,"#.0"),bgcolor=rowBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
            table.cell(tbl,6,row,stats,bgcolor=rowBg,text_color=txtColor,text_size=labelSize,height=rowHeight)
