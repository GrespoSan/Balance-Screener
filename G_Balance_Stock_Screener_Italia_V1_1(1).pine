//@version=6
indicator("🎯 G. Balance Stock Screener Italia V1.1", overlay=true, max_bars_back=700, dynamic_requests=true)

//=============================================================================
// G. BALANCE STOCK SCREENER ITALIA V1.1
//
// MOTORE BALANCE:
// Porting per screener del G. Balance Zones Pro v0.5.3.6.
// - Motore A Structural: Validation 10 default
// - Motore B Reaction: istanza indipendente, Validation 5 default
// - A e B condividono solo gli input comuni; snapshot/ranking/candidati separati
// - Le Reaction B sovrapposte alle Structural A vengono deduplicate
// - Geometria ATR default 0.20
// - Aggiornamento snapshot default ogni 1 barra
// - Motori A/B invariati rispetto alla v0.5.3.4
// - Ruolo operativo Structural: sotto il prezzo = Supporto, sopra = Resistenza, dentro = IN
// - Dominanza storica S/R mantenuta separata; Reaction B neutrale
//
// LAYER SCREENER:
// - Universo: 39 titoli italiani MIL
// - Timeframe screener default: Daily
// - Tocchi recenti configurabili
// - "Ultima candela deve essere nella Balance" = OFF di default
//   OFF: bastano i tocchi richiesti, anche se l'ultima candela è appena uscita.
//   ON : oltre ai tocchi, il close deve essere ancora dentro la fascia.
// - Nessun LONG/SHORT e nessuna previsione direzionale.
//=============================================================================

//=============================================================================
// COSTANTI E TIPO ZONA
//=============================================================================
int ROLE_SUPPORT = 1
int ROLE_RESISTANCE = -1
int ROLE_BALANCE = 0
int ENGINE_STRUCTURAL = 1
int ENGINE_REACTION = 2

type Zone
    float center
    float half
    float pctRange
    float strength
    int hits
    int supportHits
    int resistanceHits
    int dwell
    int lastHitAge
    int independentTests
    int independentSuccesses
    int independentSupportSuccess
    int independentResistanceSuccess
    int independentBreaks
    float reliability

//=============================================================================
// INPUT — SCREENING BALANCE
//=============================================================================
string gActive = "🎯 Screening Balance"
string screenerTf = input.timeframe("D", "Timeframe screener", group=gActive, tooltip="Timeframe usato dallo screening, indipendente dal timeframe del grafico.\nDefault: Daily (D).")
bool requireLastInside = input.bool(false, "Ultima candela deve essere nella Balance", group=gActive, tooltip="OFF (default): bastano i tocchi richiesti nella finestra recente, anche se l'ultima candela ha già lasciato la fascia.\nON: richiede anche che il close corrente sia ancora dentro la Balance.")
int minInteractionBarsInput = input.int(2, "Tocchi minimi", minval=1, maxval=10, group=gActive, tooltip="Numero minimo di candele che devono intersecare realmente la stessa Balance.\n\nCOMBINAZIONI CONSIGLIATE\n2/3 = tempestivo, ottimo default\n3/3 = molto selettivo\n3/4 = interazione consistente\n3/5 = consolidamento sulla Balance\n4/5 = forte permanenza sulla zona\n\nNotazione: TOCCHI / CANDELE.")
int interactionWindowInput = input.int(3, "Finestra candele", minval=2, maxval=10, group=gActive, tooltip="Numero di candele recenti da controllare.\nEsempio: Tocchi minimi = 3 e Finestra candele = 5 significa 3/5.\n\nSe i Tocchi minimi superano la finestra scelta, vengono automaticamente limitati alla dimensione della finestra.")
int interactionWindow = interactionWindowInput
int minInteractionBars = math.min(minInteractionBarsInput, interactionWindowInput)

//=============================================================================
// INPUT — MOTORE BALANCE v0.5.3.6
//=============================================================================
string gBal = "⚖️ Motore Balance"
int lookback = input.int(400, "Lookback (barre TF screener)", minval=400, maxval=400, group=gBal)
float scanStepPct = input.float(1.0, "Scan Step (% range)", minval=0.25, maxval=10.0, step=0.25, group=gBal)
int maxZones = input.int(9, "Numero massimo Balance", minval=1, maxval=20, group=gBal)
int minCompatibleHits = input.int(1, "Hit compatibili minimi", minval=1, maxval=100, group=gBal)
int validationBars = input.int(10, "Validation Bars A - Structural", minval=1, maxval=50, group=gBal)
string breakSource = input.string("Close", "Break Source", options=["Close","Wick (High/Low)"], group=gBal)
float minStrength = input.float(0.0, "Strength minima", minval=0.0, maxval=100.0, step=1.0, group=gBal)
int atrLength = input.int(14, "ATR Length", minval=2, maxval=200, group=gBal)

string gReaction = "⚖️ Reaction Balance"
bool showReactionBalances = input.bool(true, "Includi Reaction Balance", tooltip="ON: lo screener considera anche il Motore B Reaction quando la zona non è sovrapposta a una Structural A.\nOFF: screening limitato alle Structural A.", group=gReaction)
int reactionValidationBars = input.int(5, "Validation Bars B - Reaction", minval=1, maxval=50, group=gReaction)

string gVal = "⚖️ Affidabilità indipendente"
bool enableIndependentValidation = input.bool(true, "Calcola test indipendenti", group=gVal)
int independentCooldownBars = input.int(6, "Cooldown tra test", minval=1, maxval=100, group=gVal)
float minReactionAtr = input.float(0.20, "Reazione minima (ATR)", minval=0.0, maxval=5.0, step=0.05, group=gVal)

string gGeo = "⚖️ Geometria Balance"
string zoneWidthMode = input.string("ATR", "Larghezza zona", options=["Percent Price","ATR","Ticks","Range %"], group=gGeo)
float zoneHalfAtr = input.float(0.20, "Semi-larghezza ATR", minval=0.01, maxval=2.0, step=0.01, tooltip="Allineato al Balance Zones Pro v0.5.3.6: 0,20 = zona larga complessivamente 0,40 ATR.", group=gGeo)
float zoneHeightPct = input.float(0.07, "Altezza totale (% prezzo)", minval=0.01, maxval=5.0, step=0.01, group=gGeo)
int zoneHalfTicks = input.int(12, "Semi-larghezza tick", minval=1, maxval=2000, group=gGeo)
float zoneHeightRangePct = input.float(1.0, "Altezza totale (% range)", minval=0.10, maxval=20.0, step=0.10, group=gGeo)
string spacingMode = input.string("Range %", "Distanza minima tra zone", options=["Range %","ATR","Percent Price"], group=gGeo)
float minSpacingRangePct = input.float(8.0, "Distanza minima (% range)", minval=0.5, maxval=50.0, step=0.5, group=gGeo)
float minSpacingAtr = input.float(0.80, "Distanza minima ATR", minval=0.05, maxval=20.0, step=0.05, group=gGeo)
float minSpacingPricePct = input.float(0.20, "Distanza minima (% prezzo)", minval=0.01, maxval=10.0, step=0.01, group=gGeo)

string gCluster = "⚖️ Clustering"
bool clusterAdjacentLevels = input.bool(false, "Centra sui livelli adiacenti", group=gCluster)
float clusterRadiusSteps = input.float(1.5, "Raggio cluster (Scan Step)", minval=0.5, maxval=5.0, step=0.5, group=gCluster)
float clusterMinStrengthRatio = input.float(0.70, "Forza minima vicino/picco", minval=0.10, maxval=1.0, step=0.05, group=gCluster)

string gStable = "⚖️ Stabilità"
int updateFrequencyBars = input.int(1, "Aggiorna zone ogni X barre", minval=1, maxval=500, tooltip="1 = nuovo snapshot ad ogni nuova barra. Lo stesso intervallo viene applicato indipendentemente ai motori A e B.", group=gStable)
bool retainPreviousZones = input.bool(true, "Mantieni zone precedenti ancora valide", group=gStable)
float retentionStrength = input.float(25.0, "Strength minima mantenimento", minval=0.0, maxval=100.0, step=1.0, group=gStable)
float retentionToleranceSteps = input.float(1.5, "Tolleranza mantenimento (Scan Step)", minval=0.25, maxval=5.0, step=0.25, group=gStable)

string gRole = "⚖️ Classificazione operativa"
float roleDominanceRatio = input.float(1.35, "Dominanza Support/Resistance", minval=1.0, maxval=5.0, step=0.05, group=gRole)
int operationalMinIndependentTests = input.int(2, "Test indipendenti minimi", minval=0, maxval=30, group=gRole)
float operationalMinReliability = input.float(35.0, "Affidabilità minima (%)", minval=0.0, maxval=100.0, step=1.0, group=gRole)
int operationalMinSuccesses = input.int(2, "Successi indipendenti minimi", minval=0, maxval=30, group=gRole)
int fallbackMinCompatibleHits = input.int(2, "Hit minimi per fallback", minval=1, maxval=100, group=gRole)

//=============================================================================
// TABELLA — GRAFICA INVARIATA
//=============================================================================
string gTab = "🔨 Tabella"
string posInput = input.string("Bottom Right", "Posizione", options=["Bottom Left","Bottom Center","Bottom Right","Top Center","Top Left","Top Right"], group=gTab)
string textSizing = input.string("Small", "Dimensione testo", options=["Auto","Tiny","Small","Normal","Large","Huge"], group=gTab)
bool onlyActive = input.bool(true, "Mostra solo Balance attive", group=gTab)
float rowHeight = input.float(2.1, "Altezza riga (%)", step=0.1, group=gTab)
color mainBg = input.color(color.rgb(184,184,184), "Sfondo Header", group=gTab)
color txtColor = input.color(color.rgb(35,35,35), "Testo", group=gTab)
color activeBg = input.color(color.rgb(225,225,227), "Sfondo righe", group=gTab)
color supportTextColor = color.rgb(0,145,90)
color resistanceTextColor = color.rgb(225,95,20)
color neutralTextColor = color.rgb(95,105,190)
color insideTextColor = color.rgb(205,165,45)
color reactionTextColor = color.rgb(135,135,135)

pos = posInput == "Bottom Left" ? position.bottom_left : posInput == "Bottom Center" ? position.bottom_center : posInput == "Bottom Right" ? position.bottom_right : posInput == "Top Left" ? position.top_left : posInput == "Top Right" ? position.top_right : position.top_center
labelSize = textSizing == "Auto" ? size.auto : textSizing == "Tiny" ? size.tiny : textSizing == "Small" ? size.small : textSizing == "Normal" ? size.normal : textSizing == "Large" ? size.large : size.huge

//=============================================================================
// HELPERS — MOTORE v0.5.3.6
//=============================================================================
f_clamp(float value, float lo, float hi) =>
    math.max(lo, math.min(hi, value))

f_zoneHalf(float center, float rng, float atrNow) =>
    float half = syminfo.mintick
    if zoneWidthMode == "Percent Price"
        half := center * zoneHeightPct / 200.0
    else if zoneWidthMode == "ATR"
        half := math.max(syminfo.mintick, atrNow * zoneHalfAtr)
    else if zoneWidthMode == "Ticks"
        half := syminfo.mintick * zoneHalfTicks
    else
        half := rng * zoneHeightRangePct / 200.0
    math.max(syminfo.mintick, half)

f_minSpacing(float refPrice, float rng, float atrNow) =>
    spacingMode == "ATR" ? math.max(syminfo.mintick, atrNow * minSpacingAtr) : spacingMode == "Percent Price" ? math.max(syminfo.mintick, refPrice * minSpacingPricePct / 100.0) : math.max(syminfo.mintick, rng * minSpacingRangePct / 100.0)

f_evaluateCompatibleV(float center, float half, int scanLimit, int validBars) =>
    float top = center + half
    float bottom = center - half
    int supportHits = 0
    int resistanceHits = 0
    int dwellBars = 0
    int nearestHitAge = na
    int firstOffset = validBars + 1
    int lastOffset = scanLimit - 1
    if lastOffset >= firstOffset
        for i = firstOffset to lastOffset
            bool overlaps = low[i] <= top and high[i] >= bottom
            if overlaps
                dwellBars += 1
                bool isSupport = close[i] >= center
                bool broken = false
                for k = 1 to validBars
                    int idx = i - k
                    if idx >= 0
                        float breakLow = breakSource == "Close" ? close[idx] : low[idx]
                        float breakHigh = breakSource == "Close" ? close[idx] : high[idx]
                        if isSupport and breakLow < bottom
                            broken := true
                        if not isSupport and breakHigh > top
                            broken := true
                if not broken
                    if isSupport
                        supportHits += 1
                    else
                        resistanceHits += 1
                    int age = i
                    nearestHitAge := na(nearestHitAge) ? age : math.min(nearestHitAge, age)
    int hits = supportHits + resistanceHits
    float hitScore = 1.0 - math.exp(-hits / 18.0)
    float dwellScore = 1.0 - math.exp(-dwellBars / 45.0)
    float roleMix = math.min(supportHits, resistanceHits) / math.max(1.0, float(math.max(supportHits, resistanceHits)))
    float freshnessScore = na(nearestHitAge) ? 0.0 : math.exp(-nearestHitAge / 200.0)
    float densityScore = hits / math.max(1.0, float(dwellBars))
    densityScore := math.min(1.0, densityScore)
    float strength = 100.0 * (0.50 * hitScore + 0.15 * dwellScore + 0.12 * roleMix + 0.13 * freshnessScore + 0.10 * densityScore)
    strength := f_clamp(strength, 0.0, 100.0)
    [supportHits, resistanceHits, hits, dwellBars, nz(nearestHitAge,99999), strength]

f_evaluateIndependentV(float center, float half, int scanLimit, int validBars, series float atrSeries) =>
    float top = center + half
    float bottom = center - half
    int tests = 0
    int successes = 0
    int supportSuccess = 0
    int resistanceSuccess = 0
    int breaks = 0
    int lastAcceptedOffset = na
    int firstOffset = validBars + 1
    int lastOffset = scanLimit - 1
    if enableIndependentValidation and lastOffset >= firstOffset
        for i = firstOffset to lastOffset
            bool overlaps = low[i] <= top and high[i] >= bottom
            bool previousAbove = close[i + 1] > top
            bool previousBelow = close[i + 1] < bottom
            bool independentEntry = overlaps and (previousAbove or previousBelow)
            bool cooldownOk = na(lastAcceptedOffset) or math.abs(i - lastAcceptedOffset) >= independentCooldownBars
            if independentEntry and cooldownOk
                bool isSupportTest = previousAbove
                bool broken = false
                float maxAway = 0.0
                float atrAtTest = math.max(nz(atrSeries[i], syminfo.mintick), syminfo.mintick)
                for k = 1 to validBars
                    int idx = i - k
                    if idx >= 0
                        float breakLow = breakSource == "Close" ? close[idx] : low[idx]
                        float breakHigh = breakSource == "Close" ? close[idx] : high[idx]
                        if isSupportTest
                            if breakLow < bottom
                                broken := true
                            maxAway := math.max(maxAway, high[idx] - center)
                        else
                            if breakHigh > top
                                broken := true
                            maxAway := math.max(maxAway, center - low[idx])
                bool reactedEnough = maxAway >= atrAtTest * minReactionAtr
                bool success = not broken and reactedEnough
                tests += 1
                if success
                    successes += 1
                    if isSupportTest
                        supportSuccess += 1
                    else
                        resistanceSuccess += 1
                if broken
                    breaks += 1
                lastAcceptedOffset := i
    float reliability = tests > 0 ? 100.0 * successes / tests : na
    [tests, successes, supportSuccess, resistanceSuccess, breaks, reliability]

f_tooCloseZone(float candidate, array<Zone> zones, float spacing) =>
    bool closeToExisting = false
    int n = array.size(zones)
    if n > 0
        for i = 0 to n - 1
            Zone z = array.get(zones,i)
            if math.abs(candidate - z.center) < spacing
                closeToExisting := true
                break
    closeToExisting

f_clusterCenter(int peakIdx, array<float> centers, array<float> strengths, float rng) =>
    float peakCenter = array.get(centers,peakIdx)
    float peakStrength = array.get(strengths,peakIdx)
    float result = peakCenter
    if clusterAdjacentLevels
        float radiusPrice = rng * scanStepPct / 100.0 * clusterRadiusSteps
        float weightedSum = 0.0
        float weightTotal = 0.0
        int n = array.size(centers)
        if n > 0
            for i = 0 to n - 1
                float c = array.get(centers,i)
                float s = array.get(strengths,i)
                if math.abs(c - peakCenter) <= radiusPrice and s >= peakStrength * clusterMinStrengthRatio
                    weightedSum += c * math.max(s,0.01)
                    weightTotal += math.max(s,0.01)
        if weightTotal > 0
            result := weightedSum / weightTotal
    result

f_buildZoneV(float center, float rangeLowNow, float rng, float atrNow, int scanLimit, int validBars, series float atrSeries) =>
    float half = f_zoneHalf(center,rng,atrNow)
    [supHits,resHits,hits,dwell,lastAge,strength] = f_evaluateCompatibleV(center,half,scanLimit,validBars)
    [indTests,indSuccesses,indSup,indRes,indBreaks,reliability] = f_evaluateIndependentV(center,half,scanLimit,validBars,atrSeries)
    float pct = rng > 0 ? 100.0 * (center - rangeLowNow) / rng : 0.0
    Zone.new(center,half,pct,strength,hits,supHits,resHits,dwell,lastAge,indTests,indSuccesses,indSup,indRes,indBreaks,reliability)

f_distZoneAtr(float px, Zone z, float atrNow) =>
    float d = na
    if atrNow > 0
        float bottom = z.center - z.half
        float top = z.center + z.half
        d := px >= bottom and px <= top ? 0.0 : px > top ? (px - top) / atrNow : (bottom - px) / atrNow
    d

// Classificazione storica pura delle sole Structural A.
f_zoneStructuralType(Zone z) =>
    int role = ROLE_BALANCE
    bool enoughIndependent = z.independentTests >= operationalMinIndependentTests and not na(z.reliability) and z.reliability >= operationalMinReliability
    if enoughIndependent
        bool supportDominant = z.independentSupportSuccess >= operationalMinSuccesses and z.independentSupportSuccess >= math.max(1.0,z.independentResistanceSuccess * roleDominanceRatio)
        bool resistanceDominant = z.independentResistanceSuccess >= operationalMinSuccesses and z.independentResistanceSuccess >= math.max(1.0,z.independentSupportSuccess * roleDominanceRatio)
        if supportDominant
            role := ROLE_SUPPORT
        else if resistanceDominant
            role := ROLE_RESISTANCE
    if role == ROLE_BALANCE
        bool compatibleSupportDominant = z.supportHits >= fallbackMinCompatibleHits and z.supportHits >= math.max(1.0,z.resistanceHits * roleDominanceRatio)
        bool compatibleResistanceDominant = z.resistanceHits >= fallbackMinCompatibleHits and z.resistanceHits >= math.max(1.0,z.supportHits * roleDominanceRatio)
        if compatibleSupportDominant
            role := ROLE_SUPPORT
        else if compatibleResistanceDominant
            role := ROLE_RESISTANCE
    role

// Deduplicazione grafico/logica: una Reaction B sovrapposta ad A non viene considerata.
f_reactionCoveredByStructural(Zone rz, array<Zone> structuralZones) =>
    bool covered = false
    int n = array.size(structuralZones)
    if n > 0
        float rTop = rz.center + rz.half
        float rBottom = rz.center - rz.half
        for i = 0 to n - 1
            Zone az = array.get(structuralZones,i)
            float aTop = az.center + az.half
            float aBottom = az.center - az.half
            if rTop >= aBottom and rBottom <= aTop
                covered := true
                break
    covered

//=============================================================================
// MOTORE PER SINGOLO SIMBOLO — A + B INDIPENDENTI
//=============================================================================
f_balanceActiveEngine() =>
    var array<Zone> snapZonesA = array.new<Zone>()
    var array<Zone> snapZonesB = array.new<Zone>()
    var int lastCalculationBarA = na
    var int lastCalculationBarB = na

    series float atrSeries = ta.atr(atrLength)
    float atrNow = math.max(nz(atrSeries,syminfo.mintick),syminfo.mintick)
    float rangeHigh = ta.highest(high,lookback)
    float rangeLow = ta.lowest(low,lookback)
    float activeRange = math.max(rangeHigh - rangeLow,syminfo.mintick * 10)
    int scanLimit = math.max(10,math.min(lookback,bar_index))

    bool calculationDueA = na(lastCalculationBarA) or bar_index - lastCalculationBarA >= updateFrequencyBars
    bool calculationDueB = na(lastCalculationBarB) or bar_index - lastCalculationBarB >= updateFrequencyBars

    //-------------------------------------------------------------------------
    // MOTORE A — STRUCTURAL
    //-------------------------------------------------------------------------
    if barstate.islast and calculationDueA and not na(rangeHigh) and not na(rangeLow) and activeRange > 0 and scanLimit > validationBars + 2
        array<float> candCenterA = array.new_float()
        array<float> candStrengthA = array.new_float()
        array<int> candHitsA = array.new_int()

        for pct = 0.0 to 100.0 by scanStepPct
            float center = rangeLow + activeRange * pct / 100.0
            float half = f_zoneHalf(center,activeRange,atrNow)
            [supHits,resHits,hits,dwell,lastAge,strength] = f_evaluateCompatibleV(center,half,scanLimit,validationBars)
            if hits >= minCompatibleHits and strength >= minStrength
                array.push(candCenterA,center)
                array.push(candStrengthA,strength)
                array.push(candHitsA,hits)

        array<Zone> newZonesA = array.new<Zone>()
        array<bool> usedA = array.new_bool(array.size(candCenterA),false)
        float spacingA = f_minSpacing(close,activeRange,atrNow)
        float retentionToleranceA = activeRange * scanStepPct / 100.0 * retentionToleranceSteps

        if retainPreviousZones and array.size(snapZonesA) > 0 and array.size(candCenterA) > 0
            for old = 0 to array.size(snapZonesA) - 1
                if array.size(newZonesA) < maxZones
                    Zone oldZone = array.get(snapZonesA,old)
                    int bestIdx = -1
                    float bestDist = 1e20
                    for c = 0 to array.size(candCenterA) - 1
                        if not array.get(usedA,c)
                            float d = math.abs(array.get(candCenterA,c) - oldZone.center)
                            if d < bestDist
                                bestDist := d
                                bestIdx := c
                    if bestIdx >= 0 and bestDist <= retentionToleranceA and array.get(candStrengthA,bestIdx) >= retentionStrength
                        float selectedCenter = f_clusterCenter(bestIdx,candCenterA,candStrengthA,activeRange)
                        if not f_tooCloseZone(selectedCenter,newZonesA,spacingA)
                            Zone z = f_buildZoneV(selectedCenter,rangeLow,activeRange,atrNow,scanLimit,validationBars,atrSeries)
                            if z.hits >= minCompatibleHits and z.strength >= minStrength
                                array.push(newZonesA,z)
                                array.set(usedA,bestIdx,true)

        array<int> sortedA = array.sort_indices(candStrengthA,order.descending)
        if array.size(sortedA) > 0
            for n = 0 to array.size(sortedA) - 1
                if array.size(newZonesA) >= maxZones
                    break
                int idx = array.get(sortedA,n)
                if not array.get(usedA,idx)
                    float selectedCenter = f_clusterCenter(idx,candCenterA,candStrengthA,activeRange)
                    if not f_tooCloseZone(selectedCenter,newZonesA,spacingA)
                        Zone z = f_buildZoneV(selectedCenter,rangeLow,activeRange,atrNow,scanLimit,validationBars,atrSeries)
                        if z.hits >= minCompatibleHits and z.strength >= minStrength
                            array.push(newZonesA,z)
                            array.set(usedA,idx,true)

        int newCountA = array.size(newZonesA)
        if newCountA > 1
            for i = 0 to newCountA - 2
                for j = i + 1 to newCountA - 1
                    Zone zi = array.get(newZonesA,i)
                    Zone zj = array.get(newZonesA,j)
                    if zi.center > zj.center
                        array.set(newZonesA,i,zj)
                        array.set(newZonesA,j,zi)

        array.clear(snapZonesA)
        if array.size(newZonesA) > 0
            for i = 0 to array.size(newZonesA) - 1
                array.push(snapZonesA,array.get(newZonesA,i))
        lastCalculationBarA := bar_index

    //-------------------------------------------------------------------------
    // MOTORE B — REACTION. Snapshot/ranking/candidati totalmente separati.
    //-------------------------------------------------------------------------
    if barstate.islast and calculationDueB and not na(rangeHigh) and not na(rangeLow) and activeRange > 0 and scanLimit > reactionValidationBars + 2
        array<float> candCenterB = array.new_float()
        array<float> candStrengthB = array.new_float()
        array<int> candHitsB = array.new_int()

        for pct = 0.0 to 100.0 by scanStepPct
            float center = rangeLow + activeRange * pct / 100.0
            float half = f_zoneHalf(center,activeRange,atrNow)
            [supHits,resHits,hits,dwell,lastAge,strength] = f_evaluateCompatibleV(center,half,scanLimit,reactionValidationBars)
            if hits >= minCompatibleHits and strength >= minStrength
                array.push(candCenterB,center)
                array.push(candStrengthB,strength)
                array.push(candHitsB,hits)

        array<Zone> newZonesB = array.new<Zone>()
        array<bool> usedB = array.new_bool(array.size(candCenterB),false)
        float spacingB = f_minSpacing(close,activeRange,atrNow)
        float retentionToleranceB = activeRange * scanStepPct / 100.0 * retentionToleranceSteps

        if retainPreviousZones and array.size(snapZonesB) > 0 and array.size(candCenterB) > 0
            for old = 0 to array.size(snapZonesB) - 1
                if array.size(newZonesB) < maxZones
                    Zone oldZone = array.get(snapZonesB,old)
                    int bestIdx = -1
                    float bestDist = 1e20
                    for c = 0 to array.size(candCenterB) - 1
                        if not array.get(usedB,c)
                            float d = math.abs(array.get(candCenterB,c) - oldZone.center)
                            if d < bestDist
                                bestDist := d
                                bestIdx := c
                    if bestIdx >= 0 and bestDist <= retentionToleranceB and array.get(candStrengthB,bestIdx) >= retentionStrength
                        float selectedCenter = f_clusterCenter(bestIdx,candCenterB,candStrengthB,activeRange)
                        if not f_tooCloseZone(selectedCenter,newZonesB,spacingB)
                            Zone z = f_buildZoneV(selectedCenter,rangeLow,activeRange,atrNow,scanLimit,reactionValidationBars,atrSeries)
                            if z.hits >= minCompatibleHits and z.strength >= minStrength
                                array.push(newZonesB,z)
                                array.set(usedB,bestIdx,true)

        array<int> sortedB = array.sort_indices(candStrengthB,order.descending)
        if array.size(sortedB) > 0
            for n = 0 to array.size(sortedB) - 1
                if array.size(newZonesB) >= maxZones
                    break
                int idx = array.get(sortedB,n)
                if not array.get(usedB,idx)
                    float selectedCenter = f_clusterCenter(idx,candCenterB,candStrengthB,activeRange)
                    if not f_tooCloseZone(selectedCenter,newZonesB,spacingB)
                        Zone z = f_buildZoneV(selectedCenter,rangeLow,activeRange,atrNow,scanLimit,reactionValidationBars,atrSeries)
                        if z.hits >= minCompatibleHits and z.strength >= minStrength
                            array.push(newZonesB,z)
                            array.set(usedB,idx,true)

        int newCountB = array.size(newZonesB)
        if newCountB > 1
            for i = 0 to newCountB - 2
                for j = i + 1 to newCountB - 1
                    Zone zi = array.get(newZonesB,i)
                    Zone zj = array.get(newZonesB,j)
                    if zi.center > zj.center
                        array.set(newZonesB,i,zj)
                        array.set(newZonesB,j,zi)

        array.clear(snapZonesB)
        if array.size(newZonesB) > 0
            for i = 0 to array.size(newZonesB) - 1
                array.push(snapZonesB,array.get(newZonesB,i))
        lastCalculationBarB := bar_index

    //-------------------------------------------------------------------------
    // SCREENING SULLE ZONE SELEZIONATE
    //-------------------------------------------------------------------------
    float bestCenter = na
    float bestHalf = na
    float bestStrength = na
    float bestReliability = na
    int bestHits = 0
    int bestTests = 0
    int bestTouches = 0
    int bestZoneType = ROLE_BALANCE
    int bestEngine = 0
    float bestDist = na
    float bestScore = -1.0

    // A — Structural: classificazione S/R storica.
    int nA = array.size(snapZonesA)
    if barstate.islast and nA > 0
        for zIdx = 0 to nA - 1
            Zone z = array.get(snapZonesA,zIdx)
            float bottom = z.center - z.half
            float top = z.center + z.half
            int touches = 0
            for k = 0 to interactionWindow - 1
                bool touchesZone = low[k] <= top and high[k] >= bottom
                if touchesZone
                    touches += 1
            bool priceInside = close >= bottom and close <= top
            bool eligible = touches >= minInteractionBars and (not requireLastInside or priceInside)
            if eligible
                float distAtr = f_distZoneAtr(close,z,atrNow)
                int zoneType = f_zoneStructuralType(z)
                float touchScore = 100.0 * float(touches) / float(interactionWindow)
                float relScore = na(z.reliability) ? 50.0 : z.reliability
                float score = f_clamp(0.45 * touchScore + 0.35 * z.strength + 0.20 * relScore,0.0,100.0)
                if score > bestScore
                    bestScore := score
                    bestCenter := z.center
                    bestHalf := z.half
                    bestStrength := z.strength
                    bestReliability := z.reliability
                    bestHits := z.hits
                    bestTests := z.independentTests
                    bestTouches := touches
                    bestZoneType := zoneType
                    bestEngine := ENGINE_STRUCTURAL
                    bestDist := distAtr

    // B — Reaction: solo se non sovrapposta ad A; nessuna classificazione S/R.
    int nB = array.size(snapZonesB)
    if barstate.islast and showReactionBalances and nB > 0
        for zIdx = 0 to nB - 1
            Zone z = array.get(snapZonesB,zIdx)
            if not f_reactionCoveredByStructural(z,snapZonesA)
                float bottom = z.center - z.half
                float top = z.center + z.half
                int touches = 0
                for k = 0 to interactionWindow - 1
                    bool touchesZone = low[k] <= top and high[k] >= bottom
                    if touchesZone
                        touches += 1
                bool priceInside = close >= bottom and close <= top
                bool eligible = touches >= minInteractionBars and (not requireLastInside or priceInside)
                if eligible
                    float distAtr = f_distZoneAtr(close,z,atrNow)
                    float touchScore = 100.0 * float(touches) / float(interactionWindow)
                    float relScore = na(z.reliability) ? 50.0 : z.reliability
                    float score = f_clamp(0.45 * touchScore + 0.35 * z.strength + 0.20 * relScore,0.0,100.0)
                    if score > bestScore
                        bestScore := score
                        bestCenter := z.center
                        bestHalf := z.half
                        bestStrength := z.strength
                        bestReliability := z.reliability
                        bestHits := z.hits
                        bestTests := z.independentTests
                        bestTouches := touches
                        bestZoneType := ROLE_BALANCE
                        bestEngine := ENGINE_REACTION
                        bestDist := distAtr

    [close,bestCenter,bestHalf,bestStrength,bestReliability,bestHits,bestTests,bestTouches,bestZoneType,bestEngine,bestDist,math.max(0.0,bestScore)]

//=============================================================================
// TICKER HELPER
//=============================================================================
f_ticker(string sym) =>
    parts = str.split(sym,":")
    array.size(parts) > 1 ? array.get(parts,1) : sym


